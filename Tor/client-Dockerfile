FROM ubuntu:latest

RUN apt update && apt install -y software-properties-common
RUN add-apt-repository ppa:apt-fast/stable && apt update && apt install -y apt-fast
RUN apt-fast install -y ubuntu-desktop
RUN apt-fast install -y x11vnc xvfb novnc websockify
RUN apt-fast install -y xfce4 dbus-x11
RUN apt install wget && wget https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && apt install -y ./google-chrome-stable_current_amd64.deb && rm google-chrome-stable_current_amd64.deb

# 日本語化 https://qiita.com/kotoha__/items/9838c023e80fbaad5695 https://qiita.com/n_oshiumi/items/cfe91c60730f602b38eb
RUN apt-fast install -y language-pack-ja-base language-pack-ja locales
RUN locale-gen ja_JP.UTF-8
ENV LANG=ja_JP.UTF-8


RUN cat <<EOF > start.sh
#!/bin/bash
if pgrep Xvfb; then pkill Xvfb; fi
if pgrep x11vnc; then pkill x11vnc; fi
if pgrep websockify; then pkill websockify; fi
rm -f /tmp/.X0-lock
Xvfb :0 -screen 0 1920x1080x24 &
sleep 2
dbus-launch &
x11vnc -forever -create -nopw -quiet -shared -display :0 -rfbport 5900 -bg &
websockify --web /usr/share/novnc/  6080 localhost:5900 &
export DISPLAY=:0
startxfce4
sleep infinity
EOF

RUN mkdir ~/Desktop && echo "[Desktop Entry]\nVersion=1.0\nName=Google Chrome\nExec=google-chrome --no-sandbox\nType=Application\n" > ~/Desktop/google-chrome.desktop && chmod +x ~/Desktop/google-chrome.desktop

CMD ["bash", "start.sh"]
